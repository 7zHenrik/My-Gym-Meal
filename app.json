{
  "expo": {
    "name": "My Gym Meal",
    "slug": "my-gym-meal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mygymmeal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mygymmeal.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Erlaube den Zugriff auf deine Fotos, um Rezeptbilder und -videos hochzuladen."
      }
    },
    "android": {
      "package": "com.mygymmeal.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF4D5E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF4D5E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Erlaube den Zugriff auf deine Fotos, um Rezeptbilder und -videos hochzuladen."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
